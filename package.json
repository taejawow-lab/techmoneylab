{
  "name": "techmoneylab",
  "type": "module",
  "version": "1.0.0",
  "description": "Master Astro template for 16 sites with per-site design tokens",
  "scripts": {
    "dev": "node node_modules/astro/astro.js dev",
    "start": "node node_modules/astro/astro.js dev",
    "build": "npm run qa:adsense && npm run qa:adsense:portfolio && node node_modules/astro/astro.js build && npm run qa:adsense:dist && npm run qa:adsense:portfolio -- --dist",
    "preview": "node node_modules/astro/astro.js preview",
    "astro": "node node_modules/astro/astro.js",
    "qa:adsense": "node scripts/adsense-review-gate.mjs",
    "qa:adsense:dist": "node scripts/adsense-review-gate.mjs --dist",
    "qa:adsense:portfolio": "node scripts/portfolio-adsense-gate.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/tailwind": "^5.1.0",
    "tailwindcss": "^3.4.0",
    "@tailwindcss/typography": "^0.5.0",
    "chart.js": "^4.4.0",
    "mermaid": "^11.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
