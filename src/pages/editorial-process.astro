---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'techmoneylab';
const lang = import.meta.env.PUBLIC_SITE_LANG || 'en';
const hasIllust = import.meta.env.PUBLIC_HAS_FEATURE_ILLUSTRATION === 'true';

const stepsKo = [
  { n: '01', title: '독자 질문과 범위 설정', body: '하나의 글은 하나의 구체적인 재무 결정을 다룹니다. 대상 독자, 기준 시점, 포함하지 않는 조언 범위를 먼저 정합니다.' },
  { n: '02', title: '공식 자료 우선 조사', body: 'IRS, SEC/Investor.gov, CFPB, FDIC, Federal Reserve, 노동부와 운용사 공시 등 원문을 우선 확인하고 날짜를 기록합니다.' },
  { n: '03', title: '주장과 출처 연결', body: '세율, 한도, 수수료, 수익률, 보험 범위처럼 확인 가능한 주장은 독자가 열어볼 수 있는 출처와 연결합니다.' },
  { n: '04', title: '초안과 편집 검토', body: 'AI 도구가 조사 정리와 초안에 보조적으로 사용될 수 있습니다. 발행 전에는 범위, 표현, 계산, 출처, 과도한 확신을 다시 검토합니다.' },
  { n: '05', title: '의사결정 도구 검토', body: '표, 체크리스트, 계산 예시는 실제 선택지를 구분하는 데 필요한 경우에만 사용하며, 장식용 반복 요소는 배제합니다.' },
  { n: '06', title: '한계와 중단 기준 표시', body: '세무·법률·투자 조언이 필요한 경계, 정보가 적용되지 않는 예외, 독자가 행동을 멈추고 전문가에게 확인해야 할 상황을 명시합니다.' },
  { n: '07', title: '갱신과 정정', body: '규정이나 수치가 바뀌면 글의 날짜와 관련 문장을 갱신합니다. 오류 제보는 editor@techmoneylab.net으로 받고 확인된 수정은 글에 표시합니다.' }
];
const stepsEn = [
  { n: '01', title: 'Define the Reader Question', body: 'Each guide addresses one specific financial decision. We define the intended reader, effective date, and what the article does not advise before drafting.' },
  { n: '02', title: 'Research Official Sources First', body: 'We prioritize original material from the IRS, SEC/Investor.gov, CFPB, FDIC, Federal Reserve, Department of Labor, and fund or provider disclosures, recording the date context.' },
  { n: '03', title: 'Map Claims to Evidence', body: 'Checkable claims about limits, fees, returns, tax treatment, or insurance coverage are linked to sources readers can inspect directly.' },
  { n: '04', title: 'Draft and Editorial Review', body: 'AI tools may assist with research organization and drafting. Before publication, the article is reviewed for scope, wording, calculations, citations, and unsupported certainty.' },
  { n: '05', title: 'Review Decision Tools', body: 'Tables, checklists, and worked examples are included only when they help distinguish real choices; repetitive decorative elements are removed.' },
  { n: '06', title: 'State Limits and Stop Conditions', body: 'We identify exceptions, uncertainty, and the point where a reader should stop and confirm the decision with a qualified tax, legal, or financial professional.' },
  { n: '07', title: 'Update and Correct', body: 'When a rule or figure changes, we update the relevant passage and date. Readers can report errors to editor@techmoneylab.net; confirmed corrections are noted in the article.' }
];
const steps = lang === 'ko' ? stepsKo : stepsEn;
const heading = lang === 'ko' ? '편집 프로세스' : 'Editorial Process';
const lede = lang === 'ko' ? `${siteName}는 다음 7단계로 조사·검토·정정을 진행합니다.` : `${siteName} uses this seven-step process for research, review, and corrections.`;
---

<BaseLayout title="Editorial Process" description={`How ${siteName} produces content`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <!-- editorial header -->
    <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 items-end mb-16 md:mb-24">
      <div class="col-span-12 md:col-span-7">
        <p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ Method · 7 Steps</p>
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.92] tracking-[-0.025em] mb-6 text-balance" style="font-family: var(--font-display);">
          {heading}
        </h1>
        <p class="text-lg md:text-xl text-foreground/70 max-w-xl leading-relaxed">
          {lede}
        </p>
      </div>
      {hasIllust && (
        <div class="col-span-12 md:col-span-5 mt-10 md:mt-0 md:-ml-8 lg:-ml-16 relative">
          <div class="absolute inset-0 bg-primary/15 -rotate-2 rounded-sm" aria-hidden="true"></div>
          <img src="/images/illustrations/feature.png" alt="" class="relative w-full h-auto rounded-sm rotate-[1.5deg] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.25)]" loading="eager" />
        </div>
      )}
    </div>

    <!-- numbered steps grid -->
    <div class="space-y-12 md:space-y-16">
      {steps.map((s) => (
        <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 pb-12 md:pb-16 border-b border-border last:border-b-0">
          <div class="col-span-12 md:col-span-3">
            <p class="text-7xl md:text-8xl font-bold leading-none tracking-[-0.04em] text-accent" style="font-family: var(--font-display);">
              {s.n}
            </p>
          </div>
          <div class="col-span-12 md:col-span-9 mt-4 md:mt-2">
            <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em] mb-4" style="font-family: var(--font-display);">
              {s.title}
            </h2>
            <p class="text-[17px] leading-[1.7] text-foreground/75 max-w-3xl">{s.body}</p>
          </div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
