---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CompoundCalculator from '../components/CompoundCalculator.astro';
import Newsletter from '../components/Newsletter.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = posts.slice(0, 3);
const recentPosts = posts.slice(3, 15);
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'techmoneylab';
const siteDescription = import.meta.env.PUBLIC_SITE_DESCRIPTION || 'Beginner investing and long-term wealth building, grounded in SEC EDGAR and Federal Reserve data. No stock picks, no market timing.';
const heroTitle = 'Investing for the<br /><em>long term</em>, cited from real filings';
const heroSubtitle = import.meta.env.PUBLIC_SITE_HERO_SUBTITLE || siteDescription;
const heroImage = featuredPosts[0]?.data.heroImage || '/images/illustrations/hero.png';
const filterLabels = [
  ['all', 'All'],
  ['tax', 'Tax planning'],
  ['etf', 'ETFs and Funds'],
  ['cash', 'Cash management'],
  ['retire', 'Retirement'],
  ['crypto', 'Crypto'],
];
function filterKey(category = '', title = '') {
  const c = `${category} ${title}`.toLowerCase();
  if (c.includes('crypto') || c.includes('bitcoin')) return 'crypto';
  if (c.includes('tax') || c.includes('roth') || c.includes('withholding') || c.includes('529')) return 'tax';
  if (c.includes('cash') || c.includes('treasury') || c.includes('money market') || c.includes('t-bill') || c.includes('fdic')) return 'cash';
  if (c.includes('retire') || c.includes('401') || c.includes('ira') || c.includes('hsa') || c.includes('fsa')) return 'retire';
  if (c.includes('etf') || c.includes('fund') || c.includes('portfolio') || c.includes('vanguard') || c.includes('dividend')) return 'etf';
  return 'tax';
}
---

<BaseLayout title="Home" description={siteDescription}>
  <Hero title={heroTitle} subtitle={heroSubtitle} illustration={heroImage} ctaText="Read the latest" ctaHref={featuredPosts[0] ? `/posts/${featuredPosts[0].slug}/` : '/posts/'} />
  <TrustStrip />

  {featuredPosts.length > 0 && (
    <section class="section" id="featured">
      <div class="wrap">
        <div class="sec-head reveal">
          <div>
            <span class="kicker"><span class="num">¶ 01</span><span class="dot"></span> Editor's picks</span>
            <h2 style="margin-top:12px">Featured</h2>
            <p class="sub">Hand-picked stories grounded in primary sources — what's worth your attention right now.</p>
          </div>
          <a class="sec-link" href="/posts/">View archive →</a>
        </div>
        <div class="feat-grid">
          {featuredPosts.map((post, i) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              href={`/posts/${post.slug}/`}
              image={post.data.heroImage}
              category={post.data.category}
              pubDate={post.data.pubDate}
              variant={i === 0 ? 'feature' : 'standard'}
              index={i}
              slug={post.slug}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="section" id="recent">
      <div class="wrap">
        <div class="sec-head reveal">
          <div>
            <span class="kicker"><span class="num">¶ 02</span><span class="dot"></span> From the archive</span>
            <h2 style="margin-top:12px">Recent</h2>
            <p class="sub">↓ <span data-recent-count>{recentPosts.length}</span> stories · Sorted by date</p>
          </div>
        </div>
        <div class="filters reveal">
          {filterLabels.map(([key, label], i) => <button class={`chip ${i === 0 ? 'active' : ''}`} data-filter={key}>{label}</button>)}
        </div>
        <div class="post-list">
          {recentPosts.map((post, i) => (
            <a class="post-row" href={`/posts/${post.slug}/`} data-cat={filterKey(post.data.category, post.data.title)}>
              <span class="pr-num">No. {String(i + 1).padStart(2, '0')}</span>
              <span class="pr-main">
                <span class="pr-cat">{post.data.category || filterKey('', post.data.title)}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </span>
              <span class="pr-date">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}<svg class="pr-arrow" viewBox="0 0 24 24" width="16" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-3px;margin-left:8px"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CompoundCalculator />
  <Newsletter />
</BaseLayout>
