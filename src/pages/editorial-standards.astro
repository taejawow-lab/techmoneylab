---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteName = import.meta.env.PUBLIC_SITE_NAME || 'techmoneylab';
const lang = import.meta.env.PUBLIC_SITE_LANG || 'en';
const hasIllust = import.meta.env.PUBLIC_HAS_CATEGORY_ILLUSTRATION === 'true';

const sections = lang === 'ko' ? [
  { label: 'I', title: '우선하는 출처', items: ['정부·규제기관 원문: IRS, SEC/Investor.gov, CFPB, FDIC, Federal Reserve, 노동부', '공식 펀드 문서와 금융기관 수수료·계약 공시', '동료평가 연구와 공신력 있는 장기 시계열', '독자가 직접 열어볼 수 있는 최신 원문 링크'] },
  { label: 'II', title: '출처 사용 원칙', items: ['블로그·검색 요약은 핵심 주장의 최종 근거로 사용하지 않음', '업체 홍보 문구와 공식 계약·수수료 문서를 구분', '직접 사용하지 않은 제품이나 서비스를 체험한 것처럼 표현하지 않음', '과거 수익률을 미래 성과로 표현하지 않음'] },
  { label: 'III', title: '정정 정책', body: '오류 제보를 받으면 근거를 확인하고 관련 문장과 갱신일을 수정합니다. 중요한 수정은 글에 변경 내용을 표시합니다.' },
  { label: 'IV', title: '협찬·제휴 정책', body: '유료 추천은 받지 않습니다. 제휴 링크가 있는 경우 독자의 비용과 편집 판단에 영향을 주지 않으며 해당 페이지에 공개합니다.' },
  { label: 'V', title: 'AI 사용과 책임', body: 'AI 도구는 조사 정리와 초안 작성에 보조적으로 사용될 수 있습니다. 출처 연결, 범위, 계산, 위험 문구와 최종 발행 판단은 편집 과정에서 검토합니다.' }
] : [
  { label: 'I', title: 'Sources We Prioritize', items: ['Original government and regulator material: IRS, SEC/Investor.gov, CFPB, FDIC, Federal Reserve, and Department of Labor', 'Official fund documents and financial-provider fee or account disclosures', 'Peer-reviewed research and credible long-run datasets', 'Current source links that readers can open directly'] },
  { label: 'II', title: 'How We Use Sources', items: ['Blogs and search summaries are not the final evidence for material claims', 'We distinguish marketing copy from official contracts, fee schedules, and filings', 'We do not describe products or services as personally tested when they were not', 'Past performance is not presented as a promise of future results'] },
  { label: 'III', title: 'Corrections Policy', body: 'When an error is reported, we check the evidence and update the relevant passage and review date. Material corrections are noted in the article.' },
  { label: 'IV', title: 'Sponsorship and Affiliate Policy', body: 'We do not accept paid recommendations. Affiliate relationships, when present, do not change the reader price or editorial conclusion and are disclosed on the relevant page.' },
  { label: 'V', title: 'AI Use and Accountability', body: 'AI tools may assist with research organization and drafting. Citation mapping, scope, calculations, risk language, and the final publication decision are reviewed as part of the editorial process.' }
];

const heading = lang === 'ko' ? '편집 기준' : 'Editorial Standards';
---

<BaseLayout title="Editorial Standards" description={`${siteName} editorial standards`}>
  <article class="container mx-auto px-6 md:px-10 py-16 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 items-end mb-16 md:mb-24">
      <div class="col-span-12 md:col-span-7">
        <p class="text-[10px] uppercase tracking-[0.25em] font-mono text-accent mb-4">¶ Standards · I–V</p>
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.92] tracking-[-0.025em] mb-6 text-balance" style="font-family: var(--font-display);">
          {heading}
        </h1>
      </div>
      {hasIllust && (
        <div class="col-span-12 md:col-span-5 mt-10 md:mt-0 md:-ml-8 lg:-ml-16 relative">
          <div class="absolute inset-0 bg-accent/15 rotate-2 rounded-sm" aria-hidden="true"></div>
          <img src="/images/illustrations/category.png" alt="" class="relative w-full h-auto rounded-sm -rotate-[1deg] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.25)]" loading="eager" />
        </div>
      )}
    </div>

    <div class="space-y-14">
      {sections.map((s) => (
        <div class="grid grid-cols-12 gap-x-6 md:gap-x-8 pb-12 border-b border-border last:border-b-0">
          <div class="col-span-12 md:col-span-2">
            <p class="text-5xl md:text-6xl font-bold leading-none tracking-[-0.03em] text-accent" style="font-family: var(--font-display);">{s.label}</p>
          </div>
          <div class="col-span-12 md:col-span-10 mt-4 md:mt-1">
            <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.01em] mb-5" style="font-family: var(--font-display);">{s.title}</h2>
            {s.items && (
              <ul class="space-y-2.5 text-[17px] leading-[1.7] text-foreground/75 list-none pl-0">
                {s.items.map(it => <li class="border-l-2 border-border pl-4">{it}</li>)}
              </ul>
            )}
            {s.body && <p class="text-[17px] leading-[1.7] text-foreground/75 max-w-3xl">{s.body}</p>}
          </div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
