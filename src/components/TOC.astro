---
export interface Props { headings: Array<{ depth:number; slug:string; text:string }> }
const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---
{filtered.length > 0 && <aside class="toc" data-toc><div class="toc-label">Contents</div><nav>{filtered.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}</nav><div class="toc-share"><button class="icon-btn" data-bm={Astro.url.pathname} aria-label="Save"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 4h12a1 1 0 0 1 1 1v15l-7-4-7 4V5a1 1 0 0 1 1-1Z"/></svg></button></div></aside>}