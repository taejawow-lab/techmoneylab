---
import BrandMark from './BrandMark.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'techmoneylab';
const description = import.meta.env.PUBLIC_SITE_DESCRIPTION || 'Beginner investing and long-term wealth building, grounded in SEC EDGAR and Federal Reserve data. No stock picks, no market timing.';
const currentYear = new Date().getFullYear();
---
<footer class="footer"><div class="wrap"><div class="foot-top"><div class="foot-brand"><BrandMark /><h3>techmoneylab</h3><p>{description}</p></div><div class="foot-col"><h4>Sections</h4><a href="/posts/">Posts</a><a href="/categories/">Categories</a><a href="/#calc">Tools</a><a href="/editorial-process/">Editorial</a></div><div class="foot-col"><h4>Editorial</h4><a href="/editorial-process/">Editorial process</a><a href="/editorial-standards/">Editorial standards</a><a href="/contact/">Corrections policy</a><a href="/about/">About</a></div><div class="foot-col"><h4>Follow</h4><a href={import.meta.env.PUBLIC_SITE_YOUTUBE || '/rss.xml'}>YouTube →</a><a href={import.meta.env.PUBLIC_SITE_INSTAGRAM || '/rss.xml'}>Instagram →</a><a href={import.meta.env.PUBLIC_SITE_PINTEREST || '/rss.xml'}>Pinterest →</a><a href="/rss.xml">RSS →</a></div></div><p class="foot-disclosure">Content on this site is produced with AI assistance. All data points are verified against primary sources, and all sources are linked inline for direct verification. As an Amazon Associate and other affiliate partner, we earn from qualifying purchases; such links are clearly disclosed. This content is for informational purposes and is not investment advice.</p><div class="foot-bottom"><span>© {currentYear} {siteName} · All rights reserved</span><span>Set in Newsreader and Pretendard · Quarter 01</span></div></div></footer>