---
export interface Props { title:string; subtitle:string; illustration?:string; ctaText?:string; ctaHref?:string; }
const { title, subtitle, illustration='/images/illustrations/hero.png', ctaText='Read the latest', ctaHref='/posts/' } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    <div class="hero-text">
      <div class="hero-eyebrow"><span class="kicker"><span class="num">No. 01</span><span class="dot"></span> Lead story</span></div>
      <h1 set:html={title}></h1>
      <p class="hero-lede">{subtitle}</p>
      <div class="hero-cta"><a class="cta-primary" href={ctaHref}>{ctaText}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a><span class="cta-text">Published weekly · Free</span></div>
    </div>
    <figure class="hero-figure">
      <div class="hero-art">{illustration ? <img src={illustration} alt="" loading="eager" decoding="async" class="article-cover-img" /> : <><span class="ph-corner">cover illustration · 4:3.4</span><span class="ph-label">Cover artwork</span></>} </div>
      <figcaption class="hero-cap"><span>↑ Cover illustration</span><span>Editorial · Curated · Cited</span></figcaption>
    </figure>
  </div>
</section>