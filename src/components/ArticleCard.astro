---
export interface Props { title:string; description:string; href:string; image?:string; category?:string; pubDate:Date; variant?:'feature'|'standard'; index?:number; slug?:string; }
const { title, description, href, image, category, pubDate, variant='standard', index=0, slug=href } = Astro.props;
const dateline = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const itemNum = String(index + 1).padStart(2, '0');
---
<a class={`card ${variant === 'feature' ? 'lead' : ''} ${image ? 'has-img' : ''} reveal`} href={href}>
  <div class="card-art">
    <span class="card-num">No. {itemNum}</span>
    <button class="bm" data-bm={slug} aria-label="Save"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h12a1 1 0 0 1 1 1v15l-7-4-7 4V5a1 1 0 0 1 1-1Z"/></svg></button>
    {image ? <img src={image} alt={title} loading="lazy" decoding="async" /> : <span class="ph">illustration · 16:9</span>}
  </div>
  <div class="card-body">
    {category && <span class="cat-tag">{category}</span>}
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="card-foot"><span class="card-meta">{dateline}</span><span class="read-arrow">Read →</span></div>
  </div>
</a>