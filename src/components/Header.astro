---
import BrandMark from './BrandMark.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'techmoneylab';
const navItems = [
  { label: 'Posts', href: '/posts/' },
  { label: 'Categories', href: '/categories/' },
  { label: 'Tools', href: '/#calc' },
  { label: 'Editorial', href: '/editorial-process/' },
  { label: 'About', href: '/about/' },
];
---
<div class="topbar">
  <div class="wrap">
    <div class="tb-left"><span>{siteName} · Quarter 01</span><span class="dot"></span><span data-today></span></div>
    <div class="tb-right"><span class="live">● Data-verified</span><span>Primary sources cited</span><span>Disclosures transparent</span></div>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${siteName} home`}>
      <BrandMark />
      <span><span class="bname">tech<b>moneylab</b></span><span class="btag">A data-grounded publication</span></span>
    </a>
    <nav class="nav" id="nav" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-tools">
      <a class="icon-btn" aria-label="Saved posts" title="Saved" href="/posts/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h12a1 1 0 0 1 1 1v15l-7-4-7 4V5a1 1 0 0 1 1-1Z"/></svg></a>
      <a class="icon-btn" aria-label="Search" title="Search" href="/search/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
      <button class="icon-btn" data-theme-toggle data-theme-icon aria-label="Toggle theme" title="Dark / light mode">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="display:none"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></svg>
      </button>
      <a class="btn-sub" href="/#news">Subscribe</a>
      <button class="icon-btn menu-toggle" data-menu-toggle aria-label="Menu" aria-expanded="false">
        <svg class="i-bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="display:none"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobile-nav">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="btn-sub" style="margin-top:8px;width:100%;height:48px" href="/#news">Subscribe to the newsletter</a>
  </div>
</header>