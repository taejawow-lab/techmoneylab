---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import References from '../components/References.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
export interface Props { title:string; description:string; pubDate:Date; updatedDate?:Date; heroImage?:string; tags?:string[]; category?:string; sources?:Array<{title:string;url:string;author?:string;year?:string}>; affiliate?:boolean; visualsCount?:number; hasVideo?:boolean; headings?:Array<{depth:number;slug:string;text:string}>; faq?:Array<{question:string;answer:string}>; internalLinks?:string[]; }
const { title, description, pubDate, updatedDate, heroImage, tags=[], category, sources=[], affiliate=false, visualsCount=0, hasVideo=false, headings=[], faq=[], internalLinks=[] } = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://techmoneylab.net'));
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'techmoneylab';
const categorySlug = category ? category.toLowerCase().trim().replace(/\s+/g, '-') : '';
const articleSchema = {'@type':'Article', headline:title, description, image:heroImage, datePublished:pubDate?.toISOString(), dateModified:(updatedDate||pubDate)?.toISOString(), author:{'@type':'Organization', name:`${siteName} Editorial Team`, url:siteUrl}, publisher:{'@type':'NewsMediaOrganization', name:siteName, url:siteUrl}};
const breadcrumbSchema = {'@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem', position:1, name:siteName, item:`${siteUrl}/`}, ...(category?[{'@type':'ListItem', position:2, name:category, item:`${siteUrl}/category/${categorySlug}/`}]:[]), {'@type':'ListItem', position:category?3:2, name:title, item:`${siteUrl}${Astro.url.pathname}`} ]};
const faqSchema = faq.length ? {'@type':'FAQPage', mainEntity: faq.map(q=>({'@type':'Question', name:q.question, acceptedAnswer:{'@type':'Answer', text:q.answer}}))} : null;
const schema = {'@context':'https://schema.org', '@graph': faqSchema ? [articleSchema,breadcrumbSchema,faqSchema] : [articleSchema,breadcrumbSchema]};
const locale = 'en-US';
---
<BaseLayout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate?.toISOString()} modifiedTime={(updatedDate || pubDate)?.toISOString()} schema={schema}>
  <div class="progress-track"><div class="bar" data-progress></div></div>
  <section class="art-hero"><div class="wrap"><nav class="breadcrumb"><a href="/">Home</a><span>›</span>{category && <><a href={`/category/${categorySlug}/`} class="art-cat">{category}</a><span>›</span></>}<span>{title}</span></nav><h1 class="art-title">{title}</h1><p class="art-dek">{description}</p><div class="art-meta"><div class="author"><span class="av">TM</span><span class="who"><b>techmoneylab editors</b><span>Data-verified</span></span></div><span class="meta-divider"></span><span class="meta-bit">Published<b>{pubDate?.toLocaleDateString(locale)}</b></span>{updatedDate && updatedDate.getTime() !== pubDate.getTime() && <><span class="meta-divider"></span><span class="meta-bit">Updated<b>{updatedDate.toLocaleDateString(locale)}</b></span></>}<span class="meta-divider"></span><span class="meta-bit">Sources<b>{sources.length} cited</b></span>{visualsCount > 0 && <><span class="meta-divider"></span><span class="meta-bit">Visuals<b>{visualsCount}</b></span></>}<div class="art-actions"><button class="icon-btn" data-bm={Astro.url.pathname} aria-label="Save"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4h12a1 1 0 0 1 1 1v15l-7-4-7 4V5a1 1 0 0 1 1-1Z"/></svg></button></div></div>{heroImage && <div class="art-cover"><img class="article-cover-img" src={heroImage} alt={title} loading="eager" decoding="async" /></div>}</div></section>
  {affiliate && <div class="wrap"><AffiliateDisclosure /></div>}
  <div class="wrap"><div class="art-layout"><TOC headings={headings} /><article class="prose prose-article" data-article-body><slot />{sources.length > 0 && <References sources={sources} />}</article></div></div>
  {internalLinks.length > 0 && <section class="related"><div class="wrap"><span class="kicker"><span class="num">¶</span><span class="dot"></span> Related</span><div class="post-list" style="margin-top:24px">{internalLinks.map((link, i) => <a class="post-row" href={link}><span class="pr-num">No. {String(i+1).padStart(2,'0')}</span><span class="pr-main"><span class="pr-cat">Related reading</span><h3>{link}</h3></span><span class="pr-date">Open →</span></a>)}</div></div></section>}
  {tags.length > 0 && <div class="wrap"><footer class="art-foot"><div class="tag-row">{tags.map((tag)=><a class="t" href={`/tags/${tag.toLowerCase().trim().replace(/[\/&%?#=]/g,'-').replace(/\s+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'')}/`}>#{tag}</a>)}</div></footer></div>}
</BaseLayout>